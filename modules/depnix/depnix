###############################################################
### helper funcs ##############################################
###############################################################

split_args() {

  pos_args=()
  flag_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -k|-c) # consuming args
        flag_args+=("$1" "$2")
        shift 1 # FIXED: This bug is caused when shift 2: a consuming arg with no provided arg will loop forever
        shift 1
        ;;
      -*)
        flag_args+=("$1")
        shift
        ;;
      *)
        pos_args+=("$1")
        shift
        ;;
    esac
  done
}

lsconfig() {
  flakename=$1
  Conf=$(nix eval --json ".#nixosConfigurations.$1.config.depnix" |jq)
  echo "nixosConfiguration.$1.depnix = $Conf"
}

###############################################################
### main ######################################################
###############################################################

main() {

  split_args "$@"
  set -- "${flag_args[@]}"

  while getopts $allargs opt; do
    case $opt in
      d) debug="1" ;;
      *) : ;;
    esac
  done
  OPTIND=1
  [ "$debug" ] && echo "Debug Enabled"

  set -- "${pos_args[@]}"

  mode=$1

  case "$mode" in
    "ls")
      shift
      ls-mode "$@" && exit 0
    ;;
    "genkey")
      shift
      genkey-mode "$@" && exit 0
    ;;
    "rekey")
      shift
      rekey-mode "$@" && exit 0
    ;;
    "deploy")
      shift
      deploy-mode "$@" && exit 0
    ;;
    "test")
      rebuild-mode "$@" && exit 0
    ;;
    "boot")
      rebuild-mode "$@" && exit 0
    ;;
    "switch")
      rebuild-mode "$@" && exit 0
    ;;
    "ssh")
      shift
      ssh-mode "$@" && exit 0
    ;;
    *)
      show_help && exit 1;
    ;;

  esac
}

###############################################################
### modes #####################################################
###############################################################
ls-mode() {
#### 
  # Parse args =============================================================================
  [ "$debug" ] && echo "lsmode entered"
  set -- "${flag_args[@]}"

  [ "$debug" ] && echo "Flags set:" "$@"

  while getopts $allargs opt; do
    case $opt in
      h)
        echo -e "Usage:"
        echo -e "    ${RED}depnix ls${GREEN} [options] [<nixosConfiguration...>]${CLEAR}"
        echo -e "Options:"
        echo -e "    -h | --help"
        exit 0 ;;
      *) : ;;
    esac
  done
  OPTIND=1
  [ "$debug" ] && echo "Opts parsed"

  set -- "${pos_args[@]}" && shift
  [ "$debug" ] && echo "Positional args set:" "$@"

  # gather info =============================================================================
  nixosNames="$(nix eval --json .#nixosConfigurations --apply 'builtins.attrNames' | jq -r '.[]' | tr '\n' ' ')"

  # list configs =============================================================================
  [ "$debug" ] && echo "nixosNames parsed:" "$nixosNames"
  if [ $# -lt 1 ]; then
    [ "$debug" ] && echo "No nixos systems chosen, checking all"
    for name in $nixosNames; do
      lsconfig "$name"
    done
  else
    [ "$debug" ] && echo "Selected nixos systems: $*"
    for arg in "$@"; do
      for name in $nixosNames; do
        if [ "$arg" == "$name" ]; then
          lsconfig "$name"
        fi
      done
    done
  fi
}

genkey-mode() {
#### 
  # Parse args =============================================================================
  [ "$debug" ] && echo "genkey entered"
  set -- "${flag_args[@]}"
  [ "$debug" ] && echo "Flag Args set:" "$@"

  while getopts $allargs opt; do
    case $opt in
      h)
        echo -e "Usage:"
        echo -e "    ${RED}depnix genkey${GREEN} [options] <nixosConfiguration>${CLEAR}"
        echo -e "Options:"
        echo -e "    -h | --help    Show help dialog"
        exit 0 ;;
      *) : ;;
    esac
  done
  OPTIND=1
  [ "$debug" ] && echo "getopts parsed:" "$@"

  set -- "${pos_args[@]}" && shift
  [ "$debug" ] && echo "Positional Args set:" "$@"

  if ! [ $# -eq 1 ]; then
    echo "Invalid number of arguments"
    echo "See help with: depnix genkey -h"
    exit 1
  fi

  [ "$debug" ] && echo "Checks passed"

  # gather values =============================================================================
  flakename="$1"
  [ "$debug" ] && echo "flake: $flakename"

  nixosNames="$(nix eval --json .#nixosConfigurations --apply 'builtins.attrNames' | jq -r '.[]' | tr '\n' ' ')"
  for name in $nixosNames; do
    if [ "$name" == "$flakename" ]; then
      [ "$debug" ] && echo "flake: $flakename"
      [ "$debug" ] && echo "name: $name"
      success=true
    fi
  done
  if ! $success; then
    echo "$flakename is not a nixosConfiguration"
    exit 1
  fi

  [ "$debug" ] && echo "Nixos Found: $flakename"

  deploy=$(nix eval .#nixosConfigurations."$flakename".config.depnix.deploy --json|jq -r )
  [ "$debug" ] && echo "Deploy: $deploy"

  keydir=$(jq -r '.sshHostKeyDir' <<< "$deploy")
  [ "$debug" ] && echo "keydir: $keydir"
  [ -z "$keydir" ] && echo "No keydirectory specified. See help with depnix genkey -h" && exit 1

  keyfile="$keydir/${flakename}_sshhostkeys.tgz.enc"
  [ "$debug" ] && echo "keyfile: $keyfile"
  if [ -f "$keyfile" ]; then
    gum confirm --default=no --prompt.foreground="#69CC5C" --selected.background="#69CC5C" --selected.foreground="235" \
    "Keys ($keyfile) already exists are you sure you want to overwrite?" || exit 0
  fi

  temp=$(mktemp -d)
  [ "$debug" ] && echo "temp: $temp"

  encryptionKey=$(jq -r '.encryptionKey' <<< "$deploy" )
  [ "$debug" ] && echo "encryptionKey: $encryptionKey"

  echo "Generating and encrypting SSH keys for $flakename..."

  pubkeyfile="${keydir}/${flakename}_ssh_host_ed25519_key.pub"

  # generate and encrypt keys ====================================================================
  install -d -m700 "$temp/etc/ssh"
  ssh-keygen -Af "$temp"
  [ "$debug" ] && echo "sshkeys made:"
  [ "$debug" ] && ls -lhA "$temp/etc/ssh"

  echo "Generated keys ..."
  [ -d "$keydir" ] || mkdir -p "$keydir"
  tar -cz -C "$temp" etc | age -e -o "$keyfile" -r "$encryptionKey"
  awk  '{print $1 " " $2}' <<< "$(cat "$temp/etc/ssh/ssh_host_ed25519_key.pub")" > "$pubkeyfile"

  echo "Keys encrypted and saved here: $keyfile"
  echo ""
  echo "You can use this key for decrypting secrets with agenix/sopsnix"
  echo "Use the host key to encrypt all secrets this host needs:"
  echo "path: $pubkeyfile"
  echo  "contents: $(cat "$pubkeyfile")"
  echo ""
  rm -rf "$temp"
  [ "$debug" ] && echo "temp directory cleaned"
}

rekey-mode() {
#### 
  # Parse args =============================================================================
  [ "$debug" ] && echo "rekey entered"
  set -- "${flag_args[@]}"
  [ "$debug" ] && echo "Flag Args set:" "$@"

  while getopts $allargs opt; do
    case $opt in
      h)
        echo -e "Usage:"
        echo -e "    ${RED}depnix rekey${GREEN} [options] <nixosConfiguration>${CLEAR}"
        echo -e "Options:"
        echo -e "    -h | --help"
        echo -e "    -k | --key /path/to/old/private/key"
        exit 0
        ;;
      k)
        oldkey="$OPTARG"
        [ "$debug" ] && echo "oldkey set"
        ;;
    esac
  done
  OPTIND=1
  [ "$debug" ] && echo "getopts parsed:" "$@"

  [ -z "$oldkey" ] && echo "No old key specified, we need one to decrypt the keys prior to re-keying. See help with depnix rekey -h" && exit 1
  if ! [ -f "$oldkey" ]; then echo "The old key doesn't seem to exist, check the folder for the file"; exit 1; fi

  set -- "${pos_args[@]}" && shift
  [ "$debug" ] && echo "Positional Args set:" "$@"

  if ! [ $# -eq 1 ]; then
    echo "Invalid number of arguments"
    echo "See help with: depnix rekey -h"
    exit 1
  fi

  [ "$debug" ] && echo "Checks passed"

  # gather values =============================================================================
  flakename="$1"
  [ "$debug" ] && echo "flake: $flakename"

  nixosNames="$(nix eval --json .#nixosConfigurations --apply 'builtins.attrNames' | jq -r '.[]' | tr '\n' ' ')"
  for name in $nixosNames; do
    if [ "$name" == "$flakename" ]; then
      [ "$debug" ] && echo "flake: $flakename"
      [ "$debug" ] && echo "name: $name"
      success=true
    fi
  done
  if ! $success; then
    echo "$flakename is not a nixosConfiguration"
    exit 1
  fi
  [ "$debug" ] && echo "Nixos Found: $flakename"

  deploy=$(nix eval .#nixosConfigurations."$flakename".config.depnix.deploy --json|jq -r )
  [ "$debug" ] && echo "Deploy: $deploy"

  keydir=$(jq -r '.sshHostKeyDir' <<< "$deploy")
  [ "$debug" ] && echo "keydir: $keydir"
  [ -z "$keydir" ] && echo "No keydirectory specified. See help with depnix genkey -h" && exit 1

  keyfile="$keydir/${flakename}_sshhostkeys.tgz.enc"
  [ "$debug" ] && echo "keyfile: $keyfile"
  if ! [ -f "$keyfile" ]; then
    echo "The folder $keydir doesn't contain the file: ${flakename}_sshhostkeys.tgz.enc"
    exit 1
  fi

  temp=$(mktemp -d)
  [ "$debug" ] && echo "temp: $temp"

  encryptionKey=$(jq -r '.encryptionKey' <<< "$deploy" )
  [ "$debug" ] && echo "encryptionKey: $encryptionKey"

  decryptionKeyFile=$(jq -r '.decryptionKeyFile' <<< "$deploy" )
  [ "$debug" ] && echo "decryptionKeyFile: $decryptionKeyFile"

  # decrypt and re-encrypt keys ====================================================================
  echo "decrypting and re-encrypting SSH keys for $flakename..."

  age -d -i "$oldkey" -o - "$keyfile" | tar -C "$temp" -xz
  [ "$debug" ] && echo "Keys decrypted"
  [ "$debug" ] && ls -lhA "$temp/etc/ssh"
  tar -cz -C "$temp" etc | age -e -o "$keyfile" -r "$encryptionKey"
  awk  '{print $1 " " $2}' <<< "$(cat "$temp/etc/ssh/ssh_host_ed25519_key.pub")" > "$keyfile.pub"

  echo "Keys re-encrypted and saved here: $keydir/${flakename}_sshhostkeys.tgz.enc"
  echo ""
  rm -rf "$temp"
  [ "$debug" ] && echo "temp directory cleaned"

}

deploy-mode() {

  # Parse args =============================================================================
  [ "$debug" ] && echo "deploy entered"
  set -- "${flag_args[@]}"
  [ "$debug" ] && echo "Flag Args set:" "$@"

  while getopts $allargs opt; do
    case $opt in
      h)
        echo -e "Usage:"
        echo -e "    ${RED}depnix deploy${GREEN} [options] <nixosConfiguration>${CLEAR}"
        echo -e "Options:"
        echo -e "    -h | --help"
        echo -e "    -a | --nixos-anywhere     '--debug' "
        exit 0
        ;;
  #    a)
  #      nixosanywhereOptions=${OPTARG}
  #      ;;
    esac
  done
  OPTIND=1
  [ "$debug" ] && echo "getopts parsed:" "$@"

  set -- "${pos_args[@]}" && shift
  [ "$debug" ] && echo "Positional Args set:" "$@"

  if ! [ $# -eq 1 ]; then
    echo "Invalid number of arguments"
    echo "See help with: depnix deploy -h"
    exit 1
  fi

  [ "$debug" ] && echo "Checks passed"

  # gather info =============================================================================
  flakename="$1"
  [ "$debug" ] && echo "flake: $flakename"

  deploy=$(nix eval .#nixosConfigurations."$flakename".config.depnix.deploy --json|jq -r )
  [ "$debug" ] && echo "deploy: $deploy"

  keydir=$(jq -r '.sshHostKeyDir' <<< "$deploy")
  [ "$debug" ] && echo "keydir: $keydir"

  keyfile="$keydir/${flakename}_sshhostkeys.tgz.enc"
  [ "$debug" ] && echo "keyfile: $keyfile"
  [ -z "$keydir" ] && echo "No keydirectory specified. See help with depnix deploy -h" && exit 1
  if ! [ -f "$keyfile" ]; then
    echo "The folder $keydir doesn't contain the file: ${flakename}_sshhostkeys.tgz.enc"
    exit 1
  fi

  nixosNames="$(nix eval --json .#nixosConfigurations --apply 'builtins.attrNames' | jq -r '.[]' | tr '\n' ' ')"
  for name in $nixosNames; do
    if [ "$name" == "$flakename" ]; then
      [ "$debug" ] && echo "flake: $flakename"
      [ "$debug" ] && echo "name: $name"
      success=true
    fi
  done
  if ! $success; then
    echo "$flakename is not a nixosConfiguration"
    exit 1
  fi
  [ "$debug" ] && echo "nixos found"

  user=$(jq -r '.user' <<< "$deploy")

  host=$(jq -r '.host' <<< "$deploy")
  [ "$debug" ] && echo "host: $host"

  decryptionKey=$(eval echo "$(jq -r '.decryptionKeyFile' <<< "$deploy")")
  [ "$debug" ] && echo "decryptionKeyFile: $decryptionKeyFile"
  [ -z "$decryptionKey" ] &&  { echo "decryption key not specified, we need one to decrypt the keys prior to deployment. See help with depnix deploy -h" && exit 1; }
  [ -f "$decryptionKey" ] || { echo "The decryption key doesn't seem to exist or you don't have permissions to see it, check the folder for the file" && exit 1; }

  id=$(eval echo "$(jq -r '.id' <<< "$deploy")")
  [ "$debug" ] && echo "id: $id"

  port=$(eval echo "$(jq -r '.port' <<< "$deploy")")
  [ "$debug" ] && echo "port: $port"

  hardware=$(jq -r '.hardwareConfigFile' <<< "$deploy")
  [ "$debug" ] && echo "hardware config: $hardware"
  [ -z "$hardware" ] && exit 1

  temp=$(mktemp -d)
  [ "$debug" ] && echo "temp: $temp"

  passprompt=$(eval echo "$(jq -r '.passwordPrompt' <<< "$deploy")")
  [ "$debug" ] && echo "passprompt: $passprompt"
  if [ "$passprompt" == "true" ]; then
    pass=$(gum input --prompt.foreground="#69CC5C" --cursor.background="235" --cursor.foreground="#69CC5C" \
     --prompt "Enter your password: ")
    [ -z "$pass" ] &&  { echo "Cancelling..." && exit 1; }
    export SSHPASS="$pass"
  fi

  # TODO: add sshOptions
  # TODO: add nixOptions
  # TODO: add nixosAnywhereOptions

  # deploy =============================================================================
  echo "Decrypting ssh host keys for deployment..."
  age -d -i "$decryptionKey" -o - "$keyfile" | tar -C "$temp" -xz
  [ "$debug" ] && echo "Keys decrypted:"
  [ "$debug" ] && ls -lhA "$temp/etc/ssh"
  echo "Deploying NixOS"
  echo "================================================================================"
  [ "$debug" ] && echo nixos-anywhere -f ".#$flakename" -i "$id" -p "$port" --extra-files "$temp" --generate-hardware-config nixos-generate-config "$hardware" --target-host "$user@$host"
  [ "$debug" ] || nixos-anywhere -f ".#$flakename" -i "$id" -p "$port" --extra-files "$temp" --generate-hardware-config nixos-generate-config "$hardware" --target-host "$user@$host"
  echo "================================================================================"
  echo "Deployment successful!"
  rm -rf "$temp"
  [ "$debug" ] && echo "temp directory cleaned"

}

rebuild-mode() {

  # Parse args =============================================================================
  mode=$1
  [ "$debug" ] && echo "rebuild ($1) entered"
  set -- "${flag_args[@]}"
  [ "$debug" ] && echo "Flag Args set:" "$@"

  while getopts $allargs opt; do
    case $opt in
      h)
        echo -e "Usage:"
        echo -e "    ${RED}depnix test|boot|switch ${GREEN} [options] <nixosConfiguration>${CLEAR}"
        echo -e "Options:"
        echo -e "    -h | --help"
        exit 0
        ;;
    esac
  done
  OPTIND=1
  [ "$debug" ] && echo "getopts parsed:" "$@"

  set -- "${pos_args[@]}" && shift
  [ "$debug" ] && echo "Positional Args set:" "$@"

  if ! [ $# -eq 1 ]; then
    echo "Invalid number of arguments"
    echo "See help with: depnix -h"
    exit 1
  fi

  [ "$mode" != "test" ] && [ "$mode" != "boot" ] && [ "$mode" != "switch" ] && { echo "Invalid mode. See help with depnix -h"; exit 1; }

  [ "$debug" ] && echo "Checks passed"

  # gather info =============================================================================
  flakename="$1"
  [ "$debug" ] && echo "flake: $flakename"

  rebuild=$(nix eval .#nixosConfigurations."$flakename".config.depnix.rebuild --json|jq -r )
  [ "$debug" ] && echo "rebuild: $rebuild"

  nixosNames="$(nix eval --json .#nixosConfigurations --apply 'builtins.attrNames' | jq -r '.[]' | tr '\n' ' ')"
  for name in $nixosNames; do
    if [ "$name" == "$flakename" ]; then
      [ "$debug" ] && echo "flake: $flakename"
      [ "$debug" ] && echo "name: $name"
      success=true
    fi
  done
  if ! $success; then
    echo "$flakename is not a nixosConfiguration"
    exit 1
  fi
  [ "$debug" ] && echo "nixos found"

  user=$(jq -r '.user' <<< "$rebuild")

  host=$(jq -r '.host' <<< "$rebuild")
  [ "$debug" ] && echo "host: $host"

  id=$(eval echo "$(jq -r '.id' <<< "$rebuild")")
  [ "$debug" ] && echo "id: $id"
  [ -n "$id" ] && export NIX_SSHOPTS="-i $id"

  port=$(eval echo "$(jq -r '.port' <<< "$rebuild")")
  [ "$debug" ] && echo "port: $port"

  sudo=$(eval echo "$(jq -r '.useRemoteSudo' <<< "$rebuild")")
  if [ "$sudo" == "true" ]; then
    sudocmd="--sudo"
    [ "$debug" ] && echo "sudo is true"
  else
    sudocmd=""
    [ "$debug" ] && echo "sudo is false"
  fi

  # TODO: add sshOptions
  # TODO: add nixOptions
  # TODO: add nixosRebuildOptions

  # rebuild =============================================================================
  echo "Rebuilding NixOS"
  echo "================================================================================"
  [ "$debug" ] && env |grep NIX_SSHOPTS
  [ "$debug" ] && echo nixos-rebuild "$mode" --flake ".#$flakename" "$sudocmd" -p "$port" --target-host "$user@$host"
  [ "$debug" ] || nixos-rebuild "$mode" --flake ".#$flakename" "$sudocmd" -p "$port" --target-host "$user@$host"
  echo "================================================================================"
  echo "Rebuild successful!"
}

ssh-mode() {
#### 
  # Parse args =============================================================================
  [ "$debug" ] && echo "ssh mode entered"
  set -- "${flag_args[@]}"

  [ "$debug" ] && echo "Flags set:" "$@"

  while getopts $allargs opt; do
    case $opt in
      c) command="$OPTARG" ;;
      p) passcmd="-p" ;;
      h|*)
        echo -e "Usage:"
        echo -e "    ${RED}depnix ssh${GREEN} [options] [<nixosConfiguration...>]${CLEAR}"
        echo -e "Options:"
        echo -e "    -h | --help"
        echo -e "    -c | The command you want to run"
        echo -e "    -p | If you want to be prompted for a password"
        exit 0 ;;
    esac
  done
  OPTIND=1
  [ "$debug" ] && echo "Opts parsed"

  set -- "${pos_args[@]}" && shift
  [ "$debug" ] && echo "Positional args set:" "$@"

  # gather info =============================================================================
  nixosNames="$(nix eval --json .#nixosConfigurations --apply 'builtins.attrNames' | jq -r '.[]' | tr '\n' ' ')"

  # build inventory =============================================================================
  [ "$debug" ] && echo "nixosNames parsed:" "$nixosNames"
  if [ $# -lt 1 ]; then
    [ "$debug" ] && echo "No nixos systems chosen, checking all"
    for name in $nixosNames; do
      sshconf=$(nix eval --json ".#nixosConfigurations.$name.config.depnix.ssh" |jq -r)
      [ -n "$tmpfile" ] || tmpfile=$(mktemp -p /run/user/$UID)
      echo "$sshconf" >> "$tmpfile"
    done
  else
    [ "$debug" ] && echo "Selected nixos systems: $*"
    for arg in "$@"; do
      for name in $nixosNames; do
        if [ "$arg" == "$name" ]; then
          sshconf=$(nix eval --json ".#nixosConfigurations.$name.config.depnix.ssh" |jq -r)
          [ -n "$tmpfile" ] || tmpfile=$(mktemp -p /run/user/$UID)
          echo "$sshconf" >> "$tmpfile"
        fi
      done
    done
  fi

  # run command =============================================================================
  echo "Running commands"
  echo "================================================================================"
  [ "$debug" ] && echo ssher run -I "$tmpfile" -c "$command" "$passcmd"
  [ "$debug" ] || ssher run -I "$tmpfile" -c "$command" "$passcmd"
  echo "================================================================================"
  rm -rf "$tmpfile"
}

main "$@"
